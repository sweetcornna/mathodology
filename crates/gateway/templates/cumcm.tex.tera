% !TEX TS-program = xelatex
% CUMCM (全国大学生数学建模竞赛) paper template
% Self-contained — no external .cls / .sty files required.
\documentclass[UTF8,a4paper,12pt]{ctexart}

\usepackage[margin=2.5cm]{geometry}
\usepackage{amsmath,amssymb,amsthm}
\usepackage{graphicx}
\graphicspath{ {{"{"}}{{ graphics_root }}{{"}"}} }
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
\usepackage{calc}
% Pandoc-emitted macros that must exist in preamble. Consolidated into
% one block to drop the historical duplicate \providecommand{\tightlist}
% that landed across two separate {% raw %} sections.
{% raw %}\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\providecommand{\passthrough}[1]{#1}
\providecommand{\real}[1]{#1}
\newcounter{none}{% endraw %}
\usepackage{enumitem}
\usepackage{float}
\usepackage{hyperref}
\usepackage{fancyhdr}
\usepackage{titlesec}
\usepackage{caption}

\hypersetup{
  colorlinks=true,
  linkcolor=black,
  urlcolor=blue,
  citecolor=black,
  pdftitle={ {{ pdf_title | latex_escape }} }
}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small CUMCM}
\fancyhead[R]{\small 参赛编号：{{ team_id | latex_escape }}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

\titleformat{\section}{\Large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\large\bfseries}{\thesubsection}{0.5em}{}

\captionsetup{font=small,labelfont=bf}

\begin{document}

% =============== 承诺书 + 编号专用页（仅打印版） ===============
% Submission bundle (template=cumcm, variant="printed") injects the 承诺书
% and 编号专用页 as the first two pages here. The anonymous variant leaves
% `cover_letter_section` empty so the PDF starts directly at the 封面 —
% mandatory because the electronic upload to cumcm.cnki.net must NOT
% contain identifying or evaluation-numbering pages.
{% if cover_letter_section %}{{ cover_letter_section | safe }}{% endif %}

% =============== 封面 ===============
\begin{titlepage}
\begin{center}
\vspace*{2cm}

{\Huge\bfseries 全国大学生数学建模竞赛\par}
\vspace{0.5cm}
{\LARGE CUMCM\par}
\vspace{3cm}

\begin{tabular}{rl}
\Large 题\quad 目： & \Large {{ title | latex_escape }} \\[1.2em]
\Large 参赛编号： & \Large {{ team_id | latex_escape }} \\[1.2em]
\Large 问题编号： & \Large {{ problem_id | latex_escape }} \\
\end{tabular}

\vfill
\end{center}
\end{titlepage}

% =============== 摘要页 ===============
\thispagestyle{plain}
\begin{center}
{\LARGE\bfseries 摘\quad 要}
\end{center}
\vspace{0.5em}

{\small
{{ abstract_latex | safe }}
}

\vspace{1em}
\noindent\textbf{关键词：} \quad

\newpage

% =============== 目录 ===============
\tableofcontents
\newpage

% =============== 正文章节（问题重述等应由 Writer 作为 section 产出） ===============
{% for sec in sections %}
\section{ {{- sec.title | latex_escape -}} }
{{ sec.body_latex | safe }}

{% endfor %}

% =============== 参考文献 ===============
{% if references and references | length > 0 %}
\begin{thebibliography}{99}
{% for ref in references %}
\bibitem{ref{{ loop.index }}} {{ ref | latex_escape }}
{% endfor %}
\end{thebibliography}
{% endif %}

\end{document}
