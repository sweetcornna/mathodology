<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "studio-installer": the NSIS installer as a ZIP of one file. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Mathodology-Studio-${version}-x64-setup.exe" product-name="Mathodology Studio" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
